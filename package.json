{
  "name": "norikae",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "NORIKAE — A Tokyo motion study",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check": "npm test && npm run lint && npm run check:boundary && npm run build",
    "data:toei:audit": "node scripts/toei.mjs audit",
    "data:toei:compile": "node scripts/toei.mjs compile",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@motionstudies/core": "0.1.0-alpha.2",
    "@motionstudies/web": "0.1.0-alpha.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@motionstudies/data": "0.1.0-alpha.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.81.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
