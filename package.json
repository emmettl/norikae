{
  "name": "norikae",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "NORIKAE — A Tokyo motion study",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check": "npm test && npm run lint && npm run check:boundary && npm run build",
    "data:toei:audit": "node scripts/toei.mjs audit",
    "data:toei:compile": "node scripts/toei.mjs compile",
    "test": "node --test tests/*.test.mjs",
    "data:preview": "node scripts/build-synthetic-preview.mjs",
    "predev": "npm run data:preview",
    "prebuild": "npm run data:preview",
    "test:e2e": "playwright test",
    "check:stack": "node scripts/check-stack.mjs"
  },
  "dependencies": {
    "@motionstudies/core": "1.0.0",
    "@motionstudies/three": "1.0.0",
    "@motionstudies/web": "1.0.0",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@motionstudies/data": "1.0.0",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "@motionstudies/tooling": "1.0.0"
  },
  "packageManager": "npm@12.2.2"
}
