{
  "name": "norikae",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "NORIKAE \u2014 A Tokyo motion study",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "check:boundary": "node scripts/check-boundary.mjs",
    "check": "npm test && npm run lint && npm run check:boundary && npm run build",
    "data:toei:audit": "node scripts/toei.mjs audit",
    "data:toei:compile": "node scripts/toei.mjs compile",
    "test": "node --test tests/*.test.mjs",
    "data:preview": "node scripts/build-synthetic-preview.mjs",
    "predev": "npm run data:preview",
    "prebuild": "npm run data:preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@motionstudies/core": "0.1.0-alpha.31",
    "@motionstudies/three": "0.1.0-alpha.31",
    "@motionstudies/web": "0.1.0-alpha.31",
    "@react-three/fiber": "9.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@motionstudies/data": "0.1.0-alpha.31",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "packageManager": "npm@11.21.0"
}
